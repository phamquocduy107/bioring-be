PORT=3000
IDENTITY_GRPC_URL=localhost:50052
ECOMMERCE_GRPC_URL=localhost:50051
BIOMETRIC_GRPC_URL=localhost:50053
KNOWLEDGE_GRPC_URL=localhost:50054

# =========================================================
# AUTH / JWT
# =========================================================
JWT_ACCESS_TOKEN_SECRET=your_access_token_secret_key_here_min_32_chars
JWT_REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here_min_32_chars
JWT_ACCESS_TOKEN_EXPIRATION=86400
JWT_REFRESH_TOKEN_EXPIRATION=2592000000
FRONTEND_URL=http://localhost:3000
DEFAULT_USER_ROLE=CUSTOMER

# =========================================================
# RABBITMQ
# =========================================================
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=myapp

# Knowledge document ingestion (rag-python ingestion_worker)
RABBITMQ_INGESTION_EXCHANGE=rag.ingestion.exchange
RABBITMQ_INGESTION_QUEUE=rag.ingestion.jobs
RABBITMQ_INGESTION_DLX=rag.ingestion.dlx
RABBITMQ_INGESTION_DLQ=rag.ingestion.dlq
RABBITMQ_STATUS_QUEUE=rag.ingestion.status

# =========================================================
# REDIS
# =========================================================
REDIS_URL=redis://localhost:6379

# =========================================================
# BIOMETRIC PROCESSING
# =========================================================
BIOMETRIC_PROCESSING_URL=http://localhost:5051

# =========================================================
# POSTGRESQL (Prisma)
# =========================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bioring
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bioring?schema=public

# =========================================================
# MONGODB
# =========================================================
MONGODB_URI=mongodb://localhost:27017/mydb

# =========================================================
# MINIO (document storage)
# =========================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-documents
MINIO_USE_SSL=false

# =========================================================
# QDRANT (vector store)
# =========================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=knowledge_documents
QDRANT_VECTOR_SIZE=384

# Python rag-engine (chat query / intent detect)
RAG_ENGINE_URL=http://localhost:8000
# Timeouts Nest → Python (ms). Local LLM thường chậm hơn 15s.
RAG_ENGINE_INTENT_TIMEOUT_MS=60000
RAG_ENGINE_QUERY_TIMEOUT_MS=120000

# LM Studio / OpenAI-compatible (dùng bởi rag-python)
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=lm-studio
# LLM_MODEL=qwen2.5-7b-instruct
# LLM_REQUEST_TIMEOUT_S=45
# INTENT_RULES_FIRST=false

# Workspace mặc định cho knowledge (documents + chat), FE không cần truyền
KNOWLEDGE_DEFAULT_WORKSPACE_ID=bioring-catalog

# =========================================================
# GOOGLE OAUTH
# =========================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
