PORT=3000  # Port api-gateway
ECOMMERCE_GRPC_URL=localhost:50051  # gRPC ecommerce-service
IDENTITY_GRPC_URL=localhost:50052  # gRPC identity-service
BIOMETRIC_GRPC_URL=localhost:50053  # gRPC biometric-service
KNOWLEDGE_GRPC_URL=localhost:50054  # gRPC rag-service (knowledge)

# =========================================================
# AUTH / JWT
# =========================================================
JWT_ACCESS_TOKEN_SECRET=your_access_token_secret_key_here_min_32_chars  # Secret ký access token (≥32 ký tự)
JWT_REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here_min_32_chars  # Secret ký refresh token
JWT_ACCESS_TOKEN_EXPIRATION=86400  # TTL access token (giây)
JWT_REFRESH_TOKEN_EXPIRATION=2592000000  # TTL refresh token (giây)
FRONTEND_URL=http://localhost:3000  # URL FE (CORS, redirect OAuth)
DEFAULT_USER_ROLE=CUSTOMER  # Role mặc định khi đăng ký

# =========================================================
# RABBITMQ — map sang python-services: RABBITMQ_URL=amqp://USER:PASS@HOST:PORT
# =========================================================
RABBITMQ_USER=guest  # User đăng nhập RabbitMQ
RABBITMQ_PASS=guest  # Password RabbitMQ
RABBITMQ_HOST=localhost  # Host RabbitMQ
RABBITMQ_PORT=5672  # Port AMQP
RABBITMQ_MANAGEMENT_UI_PORT=15672  # Port management UI (dev)
RABBITMQ_VHOST=/  # Virtual host
RABBITMQ_EXCHANGE=myapp  # Exchange chung Nest (template)
RABBITMQ_INGESTION_EXCHANGE=rag.ingestion.exchange  # Exchange ingest PDF (trùng python-services)
RABBITMQ_INGESTION_QUEUE=rag.ingestion.jobs  # Queue job ingest (trùng python-services)
RABBITMQ_INGESTION_DLX=rag.ingestion.dlx  # Dead-letter exchange (trùng python-services)
RABBITMQ_INGESTION_DLQ=rag.ingestion.dlq  # Dead-letter queue (trùng python-services)
RABBITMQ_STATUS_QUEUE=rag.ingestion.status  # Queue trạng thái worker (trùng python-services)

# =========================================================
# REDIS
# =========================================================
REDIS_URL=redis://localhost:6379  # URL Redis (cache, session)

# =========================================================
# POSTGRESQL (Prisma)
# =========================================================
POSTGRES_USER=postgres  # User Postgres
POSTGRES_PASSWORD=postgres  # Password Postgres
POSTGRES_DB=bioring  # Tên database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bioring?schema=public  # DSN Prisma

# =========================================================
# MONGODB
# =========================================================
MONGODB_URI=mongodb://localhost:27017/bioring  # Connection string MongoDB
MONGODB_DB=bioring  # Tên database
MONGODB_USER=  # User (để trống nếu local không auth)
MONGODB_PASS=  # Password
MONGODB_HOST=localhost  # Host MongoDB

# =========================================================
# GOOGLE OAUTH
# =========================================================
# GOOGLE_CLIENT_ID=  # OAuth client ID
# GOOGLE_CLIENT_SECRET=  # OAuth client secret
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback  # Callback sau đăng nhập Google

# =========================================================
# INTEGRATIONS (ecommerce / deploy)
# =========================================================
# GHCR_USERNAME=  # GitHub Container Registry user
# GHCR_TOKEN=  # Token push image
# CLOUDINARY_CLOUD_NAME=  # Cloudinary upload ảnh sản phẩm
# PAYOS_CLIENT_ID=  # PayOS thanh toán

# =========================================================
# BIOMETRIC / PERSONALIZATION (Python services)
# =========================================================
BIOMETRIC_PROCESSING_URL=http://localhost:5051  # Python biometric-processing (audio)
BIOMETRIC_PROCESSING_PORT=5051  # Port biometric-processing
PERSONALIZATION_ENGINE_URL=http://localhost:8010  # Python personalization_engine (fingerprint)

# =========================================================
# MINIO — Nest: ENDPOINT+PORT+USE_SSL | Python: ENDPOINT=host:port + MINIO_SECURE
# =========================================================
MINIO_ENDPOINT=localhost  # Host MinIO (Nest SDK tách port)
MINIO_PORT=9000  # Port MinIO API
MINIO_ACCESS_KEY=minioadmin  # Access key (trùng python-services)
MINIO_SECRET_KEY=minioadmin  # Secret key (trùng python-services)
MINIO_BUCKET=knowledge-documents  # Bucket PDF knowledge (trùng python-services MINIO_BUCKET)
MINIO_USE_SSL=false  # HTTPS; Python tương đương MINIO_SECURE

# =========================================================
# QDRANT — trùng python-services QDRANT_*
# =========================================================
QDRANT_URL=http://localhost:6333  # URL API Qdrant
QDRANT_COLLECTION=knowledge_documents  # Collection vector (trùng python-services)
QDRANT_API_KEY=  # API key (để trống nếu local không auth)
QDRANT_VECTOR_SIZE=384  # Kích thước vector tham chiếu (embedding theo model Python)

# =========================================================
# RAG ENGINE — Nest rag-service → python-services (LLM/intent/cache xem python-services/.env.example)
# =========================================================
RAG_ENGINE_URL=http://localhost:8000  # URL python rag_engine
RAG_ENGINE_INTENT_TIMEOUT_MS=60000  # Timeout gọi /intent/detect (ms)
RAG_ENGINE_QUERY_TIMEOUT_MS=120000  # Timeout gọi /query (ms)
MAX_RECENT_MESSAGES=8  # Số message gần nhất (trùng python-services)
MAX_AMBIGUOUS_RECENT_MESSAGES=12  # Message khi intent mơ hồ (trùng python-services)
MAX_HISTORY_TOKENS=1200  # Giới hạn token lịch sử (trùng python-services)
MAX_PRODUCT_CANDIDATES=5  # Số sản phẩm gợi ý tối đa (trùng python-services)
MAX_PACKAGE_CANDIDATES=3  # Số gói dịch vụ gợi ý tối đa (trùng python-services)
KNOWLEDGE_DEFAULT_WORKSPACE_ID=bioring-catalog  # Workspace mặc định documents + chat
