# =========================================================
# RABBITMQ — map từ Nest: RABBITMQ_URL=amqp://USER:PASS@HOST:PORT
# =========================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672  # URL kết nối (user:pass@host:port)
RABBITMQ_INGESTION_EXCHANGE=rag.ingestion.exchange  # Exchange ingest (trùng Nest)
RABBITMQ_INGESTION_QUEUE=rag.ingestion.jobs  # Queue job ingest (trùng Nest)
RABBITMQ_INGESTION_DLX=rag.ingestion.dlx  # Dead-letter exchange (trùng Nest)
RABBITMQ_INGESTION_DLQ=rag.ingestion.dlq  # Dead-letter queue (trùng Nest)
RABBITMQ_STATUS_QUEUE=rag.ingestion.status  # Queue publish trạng thái (trùng Nest)

# =========================================================
# MINIO — trùng Nest MINIO_BUCKET/ACCESS/SECRET | Nest ENDPOINT+PORT → host:port | USE_SSL → MINIO_SECURE
# =========================================================
MINIO_ENDPOINT=localhost:9000  # Host:port ONLY (không ghi http://) — Nest: ENDPOINT+PORT
MINIO_ACCESS_KEY=minioadmin  # Access key (trùng Nest)
MINIO_SECRET_KEY=minioadmin  # Secret key (trùng Nest)
MINIO_BUCKET=knowledge-documents  # Bucket PDF knowledge (trùng Nest)
MINIO_SECURE=false  # HTTPS; Nest tương đương MINIO_USE_SSL
MINIO_PUBLIC_ENDPOINT=http://localhost:9000  # URL public object (personalization driver=minio)
TEMP_DIR=/tmp/knowledge-documents  # Thư mục tạm khi worker tải PDF

# =========================================================
# QDRANT — trùng Nest QDRANT_*
# =========================================================
QDRANT_URL=http://localhost:6333  # URL API Qdrant
QDRANT_COLLECTION=knowledge_documents  # Collection chunk (trùng Nest)
QDRANT_API_KEY=  # API key (để trống nếu local không auth)
ENABLE_RETRIEVAL_TYPE_FILTER=true  # Lọc retrieve theo retrieval_types
ENABLE_DOCUMENT_TYPE_FILTER=false  # Tương thích chunk cũ chỉ có document_type
ENABLE_RETRIEVAL_FALLBACK=true  # Retry bỏ filter nếu không ra chunk

# =========================================================
# Provider: local (LM Studio) | openrouter
# =========================================================
LLM_PROVIDER=local  # local | openrouter — chọn backend chat LLM
EMBEDDING_PROVIDER=local  # local | openrouter — đổi embed cần reindex Qdrant

# =========================================================
# LM Studio / OpenAI-compatible API (dùng khi provider=local)
# =========================================================
OPENAI_BASE_URL=http://localhost:1234/v1  # Base URL API chat + embedding local
OPENAI_API_KEY=lm-studio  # API key header Authorization
EMBEDDING_MODEL=text-embedding-bge-m3  # Model embedding ingest + retrieve
LLM_MODEL=qwen2.5-7b-instruct  # Model chat sinh câu trả lời
LLM_TEMPERATURE=0.0  # Nhiệt độ sampling (0 = ổn định hơn)
LLM_REQUEST_TIMEOUT_S=45  # Timeout mỗi request LLM (giây)

# =========================================================
# OpenRouter (dùng khi LLM_PROVIDER / EMBEDDING_PROVIDER=openrouter)
# =========================================================
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # OpenAI-compatible base URL
OPENROUTER_API_KEY=  # sk-or-v1-...
OPENROUTER_PRIMARY_MODEL=openrouter/free  # Model chat chính
OPENROUTER_FALLBACK_MODELS=  # CSV model dự phòng khi primary lỗi
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small  # Embed khi EMBEDDING_PROVIDER=openrouter
OPENROUTER_HTTP_REFERER=  # Optional ranking header
OPENROUTER_APP_TITLE=bioring-rag  # Optional X-Title header


# =========================================================
# Intent & rewrite (rag_engine)
# =========================================================
INTENT_RULES_FIRST=true  # Ưu tiên phân intent bằng rule/keyword
ENABLE_LLM_INTENT_FALLBACK=false  # Gọi LLM intent khi rule confidence thấp
ENABLE_QUERY_REWRITE=false  # Không rewrite mọi câu có lịch sử
ENABLE_QUERY_REWRITE_FALLBACK=true  # Rewrite dự phòng câu follow-up mơ hồ

# =========================================================
# History / context limits — trùng Nest MAX_*
# =========================================================
MAX_RECENT_MESSAGES=8  # Số message gần nhất từ session (trùng Nest)
MAX_AMBIGUOUS_RECENT_MESSAGES=12  # Message khi intent mơ hồ (trùng Nest)
MAX_HISTORY_TOKENS=1200  # Giới hạn token lịch sử (trùng Nest)
MAX_CHAT_HISTORY_MESSAGES=10  # Số message tối đa đưa vào prompt
MAX_CONTEXT_CHARS=6000  # Tổng ký tự context retrieval
MAX_CONTEXT_CHARS_POLICY=3500  # Giới hạn context intent policy
MAX_CONTEXT_CHARS_PACKAGE=4000  # Giới hạn context intent package
MAX_CONTEXT_CHARS_RING=5000  # Giới hạn context tư vấn nhẫn
MAX_CONTEXT_CHARS_CUSTOM_DESIGN=6000  # Giới hạn context custom design
MAX_PRODUCT_CANDIDATES=5  # Số sản phẩm gợi ý tối đa (trùng Nest)
MAX_PACKAGE_CANDIDATES=3  # Số gói gợi ý tối đa (trùng Nest)
MAX_SOURCES=4  # Số source chunk trích dẫn tối đa

# =========================================================
# Retrieval defaults (rag_engine)
# =========================================================
DEFAULT_TOP_K=4  # Số chunk retrieve mặc định
POLICY_TOP_K=3  # Top-K câu hỏi chính sách
PACKAGE_TOP_K=3  # Top-K câu hỏi gói dịch vụ
RING_TOP_K=4  # Top-K tư vấn nhẫn
CUSTOM_DESIGN_TOP_K=5  # Top-K custom design
DEFAULT_SCORE_THRESHOLD=0.12  # Ngưỡng score mặc định (OpenRouter embed ~0.1–0.3)
POLICY_SCORE_THRESHOLD=0.12  # Ngưỡng score policy
RING_SCORE_THRESHOLD=0.10  # Ngưỡng score ring recommendation
PACKAGE_SCORE_THRESHOLD=0.12  # Ngưỡng score package
CUSTOM_DESIGN_SCORE_THRESHOLD=0.10  # Ngưỡng score custom design

# =========================================================
# Cache (rag_engine)
# =========================================================
CACHE_POLICY_ANSWERS=true  # Cache câu trả lời policy trùng lặp
CACHE_RETRIEVAL_RESULTS=true  # Cache kết quả retrieval
CACHE_TTL_SECONDS=3600  # TTL cache retrieval (giây)
CACHE_ANSWER_TTL_SECONDS=1800  # TTL cache câu trả lời (giây)

# =========================================================
# Debug & môi trường chung
# =========================================================
DEBUG_RAG=false  # Log chi tiết pipeline RAG (llmCalls, cacheHit, …)
APP_ENV=development  # Môi trường chạy

# =========================================================
# PERSONALIZATION ENGINE — Nest gọi PERSONALIZATION_ENGINE_URL
# =========================================================
PERSONALIZATION_PORT=8010  # Port HTTP FastAPI
PERSONALIZATION_TEMP_DIR=.tmp/personalization  # Thư mục artifact local
FINGERPRINT_CANVAS_SIZE=1024  # Kích thước canvas vuông output (px)
FINGERPRINT_CONTENT_RATIO=0.85  # Tỷ lệ vân tay trên canvas (0–1)
FINGERPRINT_MIN_AREA=15  # Lọc blob nhỏ (px²); cao → ít nhiễu, dễ mất nét
FINGERPRINT_PADDING=24  # Padding khi crop vùng vân tay (px)
FINGERPRINT_ERODE_SIZE=10  # Erode vùng vân chính; cao → cắt mép ngoài
FINGERPRINT_ADAPTIVE_BLOCK_SIZE=31  # Block size adaptive threshold (số lẻ)
FINGERPRINT_ADAPTIVE_C=4  # Hằng số C threshold; thấp → vân dày/liền hơn
FINGERPRINT_BLUR_KSIZE=5  # Kernel Gaussian blur trước threshold (số lẻ)
FINGERPRINT_CLAHE_CLIP=2.5  # Clip limit CLAHE tăng tương phản
FINGERPRINT_APPLY_MORPHOLOGY=false  # Morphology; true → sạch hơn, dễ đứt nét mỏng

# =========================================================
# FINGERPRINT TEXTURE MAPS (preview 3D)
# =========================================================
FINGERPRINT_GENERATE_TEXTURES=false  # false = chỉ tạo qua POST /reprocess-texture
FINGERPRINT_ENGRAVE_DEPTH=0.18  # Độ sâu khắc gợi ý preview 3D
FINGERPRINT_HEIGHTMAP_BLUR=1.2  # Blur heightmap
FINGERPRINT_NORMAL_STRENGTH=2.5  # Độ mạnh normal map
FINGERPRINT_ROUGHNESS_BASE=180  # Roughness nền kim loại (0–255)
FINGERPRINT_ROUGHNESS_RIDGE=235  # Roughness vùng rãnh (0–255)
FINGERPRINT_AO_STRENGTH=0.45  # Cường độ AO trong rãnh (0–1)

# =========================================================
# Potrace (vector hóa PNG → SVG)
# =========================================================
POTRACE_TURDSIZE=3  # Bỏ path nhỏ hơn N px; thấp = giữ nhiều chi tiết
POTRACE_ALPHAMAX=0.75  # Ngưỡng góc curve
POTRACE_OPTTOLERANCE=0.06  # Độ đơn giản hóa đường cong
POTRACE_PATH=  # Đường dẫn potrace.exe; trống = auto PATH hoặc tools/potrace/

# =========================================================
# FFmpeg (soundwave audio decode — system binary, NOT pip)
# =========================================================
FFMPEG_BINARY=ffmpeg  # Binary name or absolute path; mp3/m4a/aac/ogg only

# =========================================================
# PERSONALIZATION STORAGE
# =========================================================
PERSONALIZATION_MINIO_BUCKET=bioring-personalization  # Bucket personalization (fingerprint + soundwave)
PERSONALIZATION_MINIO_PREFIX=personalization  # Object key: personalization/{stage}/{type}/{artifactId}/{file}
