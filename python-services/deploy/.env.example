# =========================================================
# Arcane .env template — copy values from deploy/.env (local)
# Do NOT commit real secrets here.
# =========================================================
DOCKER_USERNAME=kietmn
IMAGE_TAG=latest
PULL_POLICY=always

RAG_ENGINE_PORT=8000
PERSONALIZATION_PORT=8010
APP_ENV=production
DEBUG_RAG=false
TEMP_DIR=/tmp/knowledge-documents

RABBITMQ_URL=amqp://USER:PASS@HOST:5672
RABBITMQ_INGESTION_EXCHANGE=rag.ingestion.exchange
RABBITMQ_INGESTION_QUEUE=rag.ingestion.jobs
RABBITMQ_INGESTION_DLX=rag.ingestion.dlx
RABBITMQ_INGESTION_DLQ=rag.ingestion.dlq
RABBITMQ_STATUS_QUEUE=rag.ingestion.status

MINIO_ENDPOINT=HOST:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=knowledge-documents
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=http://HOST:9000
PERSONALIZATION_MINIO_BUCKET=bioring-personalization
PERSONALIZATION_MINIO_PREFIX=personalization

QDRANT_URL=http://HOST:6333
QDRANT_COLLECTION=knowledge_documents
QDRANT_API_KEY=
ENABLE_RETRIEVAL_TYPE_FILTER=true
ENABLE_DOCUMENT_TYPE_FILTER=false
ENABLE_RETRIEVAL_FALLBACK=true

LLM_PROVIDER=openrouter
EMBEDDING_PROVIDER=openrouter
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-bge-m3
LLM_MODEL=qwen2.5-7b-instruct
LLM_TEMPERATURE=0.0
LLM_REQUEST_TIMEOUT_S=45
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,openrouter/free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=bioring-rag

INTENT_RULES_FIRST=true
ENABLE_LLM_INTENT_FALLBACK=false
ENABLE_QUERY_REWRITE=false
ENABLE_QUERY_REWRITE_FALLBACK=true
MAX_RECENT_MESSAGES=8
MAX_AMBIGUOUS_RECENT_MESSAGES=12
MAX_HISTORY_TOKENS=1200
MAX_CHAT_HISTORY_MESSAGES=10
MAX_CONTEXT_CHARS=6000
MAX_CONTEXT_CHARS_POLICY=3500
MAX_CONTEXT_CHARS_PACKAGE=4000
MAX_CONTEXT_CHARS_RING=5000
MAX_CONTEXT_CHARS_CUSTOM_DESIGN=6000
MAX_PRODUCT_CANDIDATES=5
MAX_PACKAGE_CANDIDATES=3
MAX_SOURCES=4
DEFAULT_TOP_K=4
POLICY_TOP_K=3
PACKAGE_TOP_K=3
RING_TOP_K=4
CUSTOM_DESIGN_TOP_K=5
DEFAULT_SCORE_THRESHOLD=0.12
POLICY_SCORE_THRESHOLD=0.12
RING_SCORE_THRESHOLD=0.10
PACKAGE_SCORE_THRESHOLD=0.12
CUSTOM_DESIGN_SCORE_THRESHOLD=0.10
CACHE_POLICY_ANSWERS=true
CACHE_RETRIEVAL_RESULTS=true
CACHE_TTL_SECONDS=3600
CACHE_ANSWER_TTL_SECONDS=1800

PERSONALIZATION_TEMP_DIR=/tmp/personalization
PERSONALIZATION_PUBLIC_BASE_URL=http://HOST:8010
FINGERPRINT_CANVAS_SIZE=1024
FINGERPRINT_CONTENT_RATIO=0.85
FINGERPRINT_MIN_AREA=15
FINGERPRINT_PADDING=24
FINGERPRINT_ERODE_SIZE=10
FINGERPRINT_ADAPTIVE_BLOCK_SIZE=31
FINGERPRINT_ADAPTIVE_C=4
FINGERPRINT_BLUR_KSIZE=5
FINGERPRINT_CLAHE_CLIP=2.5
FINGERPRINT_APPLY_MORPHOLOGY=false
FINGERPRINT_GENERATE_TEXTURES=false
FINGERPRINT_ENGRAVE_DEPTH=0.18
FINGERPRINT_HEIGHTMAP_BLUR=1.2
FINGERPRINT_NORMAL_STRENGTH=2.5
FINGERPRINT_ROUGHNESS_BASE=180
FINGERPRINT_ROUGHNESS_RIDGE=235
FINGERPRINT_AO_STRENGTH=0.45
POTRACE_TURDSIZE=3
POTRACE_ALPHAMAX=0.75
POTRACE_OPTTOLERANCE=0.06
POTRACE_PATH=/usr/bin/potrace
FFMPEG_BINARY=ffmpeg
