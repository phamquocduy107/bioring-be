# =========================================================
# Qdrant
# =========================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
# Filter Qdrant theo retrieval_types (map từ chat intent). Cần reindex tài liệu cũ để có metadata.
ENABLE_RETRIEVAL_TYPE_FILTER=true
# Backward-compat: chunk cũ chỉ có document_type (không phải array retrieval_types).
ENABLE_DOCUMENT_TYPE_FILTER=false
# Nếu filter theo retrieval_types không ra chunk thì thử lại 1 lần bỏ filter type.
ENABLE_RETRIEVAL_FALLBACK=true

# =========================================================
# Local LLM / Embedding (OpenAI-compatible, e.g. LM Studio)
# =========================================================
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-bge-m3
LLM_MODEL=qwen2.5-7b-instruct
LLM_TEMPERATURE=0.0
LLM_REQUEST_TIMEOUT_S=45

# =========================================================
# Intent & rewrite (token / LLM-call optimization)
# =========================================================
# Prefer keyword/rule intent; default true.
INTENT_RULES_FIRST=true
# Only call LLM for intent when rules confidence is low.
ENABLE_LLM_INTENT_FALLBACK=false

# Do not rewrite every question that has history.
ENABLE_QUERY_REWRITE=false
# Rare fallback rewrite for extremely ambiguous follow-ups.
ENABLE_QUERY_REWRITE_FALLBACK=true

# =========================================================
# History / context limits
# =========================================================
MAX_RECENT_MESSAGES=8
MAX_AMBIGUOUS_RECENT_MESSAGES=12
MAX_HISTORY_TOKENS=1200
MAX_CHAT_HISTORY_MESSAGES=10

MAX_CONTEXT_CHARS=6000
MAX_CONTEXT_CHARS_POLICY=3500
MAX_CONTEXT_CHARS_PACKAGE=4000
MAX_CONTEXT_CHARS_RING=5000
MAX_CONTEXT_CHARS_CUSTOM_DESIGN=6000

MAX_PRODUCT_CANDIDATES=5
MAX_PACKAGE_CANDIDATES=3
MAX_SOURCES=4

# =========================================================
# Retrieval defaults
# =========================================================
DEFAULT_TOP_K=4
POLICY_TOP_K=3
PACKAGE_TOP_K=3
RING_TOP_K=4
CUSTOM_DESIGN_TOP_K=5

DEFAULT_SCORE_THRESHOLD=0.50
POLICY_SCORE_THRESHOLD=0.55
RING_SCORE_THRESHOLD=0.45
PACKAGE_SCORE_THRESHOLD=0.50
CUSTOM_DESIGN_SCORE_THRESHOLD=0.45

# =========================================================
# Cache (in-memory; swapable to Redis later)
# =========================================================
CACHE_POLICY_ANSWERS=true
CACHE_RETRIEVAL_RESULTS=true
CACHE_TTL_SECONDS=3600
CACHE_ANSWER_TTL_SECONDS=1800

# =========================================================
# Debug
# =========================================================
DEBUG_RAG=false
APP_ENV=development
