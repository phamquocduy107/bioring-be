  engravings_engraving_versions_engraving_idToengravings        engravings   @relation("engraving_versions_engraving_idToengravings", fields: [engraving_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                                         users?       @relation(fields: [manager_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gemstones                                                     gemstones?   @relation(fields: [selected_gemstone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  materials                                                     materials?   @relation(fields: [selected_material_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  engravings_engravings_approved_version_idToengraving_versions engravings[] @relation("engravings_approved_version_idToengraving_versions")

  @@index([engraving_id])
