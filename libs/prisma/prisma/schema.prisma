model design_drafts {
  id                         String           @id @db.Uuid
  user_id                    String?          @db.Uuid
  guest_session_id           String?          @db.VarChar(255)
  product_id                 String?          @db.Uuid
  ai_session_id              String?          @db.Uuid
  selected_user_ring_size_id String?          @db.Uuid
  design_code                String?          @unique @db.VarChar(50)
  design_source              String?          @db.VarChar(100)
  ring_style                 String?          @db.VarChar(100)
  ring_shape                 String?          @db.VarChar(100)
  ring_size                  String?          @db.VarChar(50)
  selected_material_id       String?          @db.Uuid
  selected_gemstone_id       String?          @db.Uuid
  customization_config       Json?
  estimated_price            Decimal?         @db.Decimal(18, 2)
  expires_at                 DateTime?        @db.Timestamptz(6)
  status                     String?          @db.VarChar(100)
  created_at                 DateTime?        @db.Timestamptz(6)
  updated_at                 DateTime?        @db.Timestamptz(6)
  ai_sessions                ai_sessions?     @relation(fields: [ai_session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products                   products?        @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gemstones                  gemstones?       @relation(fields: [selected_gemstone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  materials                  materials?       @relation(fields: [selected_material_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_ring_sizes            user_ring_sizes? @relation(fields: [selected_user_ring_size_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                      users?           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
