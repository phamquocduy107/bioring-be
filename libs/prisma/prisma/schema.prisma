generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model ai_messages {
  id            String      @id @db.Uuid
  ai_session_id String      @db.Uuid
  sender        String?     @db.VarChar(50)
  message       String?
  metadata      Json?
  created_at    DateTime?   @db.Timestamptz(6)
  ai_sessions   ai_sessions @relation(fields: [ai_session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ai_session_id, created_at], map: "ai_messages_session_created_idx")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model ai_sessions {
  id                   String          @id @db.Uuid
  user_id              String?         @db.Uuid
  guest_session_id     String?         @db.VarChar(255)
  topic                String?         @db.VarChar(255)
  summary              String?
  final_recommendation Json?
  created_at           DateTime?       @db.Timestamptz(6)
  updated_at           DateTime?       @db.Timestamptz(6)
  workspace_id         String?         @db.VarChar(255)
  user_preferences     Json?
  last_intent          String?         @db.VarChar(100)
  current_intent       String?         @db.VarChar(100)
  last_message         String?
  ai_messages          ai_messages[]
  users                users?          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  design_drafts        design_drafts[]

  @@index([user_id, workspace_id, updated_at(sort: Desc)], map: "ai_sessions_user_workspace_updated_idx")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model audit_logs {
  id          String    @id @db.Uuid
  user_id     String?   @db.Uuid
  action      String?   @db.VarChar(255)
  entity_name String?   @db.VarChar(255)
  entity_id   String?   @db.Uuid
  old_value   Json?
  new_value   Json?
  ip_address  String?   @db.VarChar(100)
  user_agent  String?
  created_at  DateTime? @db.Timestamptz(6)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// Personalization / ecommerce biometric files (REVIEW → APPROVED or CAPTURED).
model biometric_assets {
  id                                      String      @id @db.Uuid
  artifact_id                             String      @db.VarChar(100)
  asset_type                              String      @default("fingerprint") @db.VarChar(50)
  status                                  String      @db.VarChar(50)
  review_files                            Json?
  approved_files                          Json?
  manifest_url                            String?     @db.VarChar(500)
  created_by_staff_id                     String?     @db.Uuid
  assigned_user_id                        String?     @db.Uuid
  /// Primary link to order via orders.engraving_id → engravings.
  engraving_id                            String?     @db.Uuid
  /// @deprecated Prefer engraving_id; kept optional for transitional clients.
  order_item_id                           String?     @db.Uuid
  model_code                              String?     @db.VarChar(100)
  surface                                 String?     @db.VarChar(100)
  placement                               Json?
  approved_by                             String?     @db.Uuid
  approved_at                             DateTime?   @db.Timestamptz(6)
  approval_note                           String?
  placement_confirmed_at                  DateTime?   @db.Timestamptz(6)
  quality_score                           Decimal?    @db.Decimal(5, 2)
  created_at                              DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime?   @default(now()) @db.Timestamptz(6)
  users_biometric_assets_approved_by      users?      @relation("biometric_assets_approved_by", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_biometric_assets_assigned_user    users?      @relation("biometric_assets_assigned_user", fields: [assigned_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_biometric_assets_created_by_staff users?      @relation("biometric_assets_created_by_staff", fields: [created_by_staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  engravings                              engravings? @relation(fields: [engraving_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([engraving_id, asset_type])
  @@index([artifact_id])
  @@index([assigned_user_id])
  @@index([engraving_id])
  @@index([status])
}

model card_themes {
  id             String        @id @db.Uuid
  theme_code     String        @unique @db.VarChar(100)
  name           String        @db.VarChar(255)
  default_bg_url String?       @db.VarChar(500)
  style_config   Json?
  is_active      Boolean?      @default(true)
  created_at     DateTime?     @db.Timestamptz(6)
  qr_memories    qr_memories[]
}

