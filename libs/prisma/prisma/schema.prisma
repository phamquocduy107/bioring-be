  updated_at                                                            DateTime?            @db.Timestamptz(6)
  user_id                                                               String?              @db.Uuid
  guest_customer_id                                                     String?              @db.Uuid
  biometric_assets                                                      biometric_assets[]
  engraving_versions_engraving_versions_engraving_idToengravings        engraving_versions[] @relation("engraving_versions_engraving_idToengravings")
  engraving_versions_engravings_approved_version_idToengraving_versions engraving_versions?  @relation("engravings_approved_version_idToengraving_versions", fields: [approved_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products                                                              products?            @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                                                 users?               @relation("engravings_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
